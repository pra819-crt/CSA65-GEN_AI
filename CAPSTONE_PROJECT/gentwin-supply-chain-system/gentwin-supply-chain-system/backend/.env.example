GEMINI_API_KEY=your api key here
CORS_ORIGINS=["http://localhost:3000"]
ALPHA_COST_WEIGHT=0.1
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Auth ---
# Generate a strong random value for production, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
DB_PATH=./supply_chain_twin.db

# Seeded admin account (change the password after first login)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
